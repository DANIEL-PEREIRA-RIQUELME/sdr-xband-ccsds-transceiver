    rx_inc: '52.5'
    rx_max_el: '91'
    samp_rate: samp_rate
    tx_alt: '475.0'
    tx_inc: '53.0'
    tx_max_el: '90.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1624, 464.0]
    rotation: 0
    state: enabled
- name: import_0
  id: import
