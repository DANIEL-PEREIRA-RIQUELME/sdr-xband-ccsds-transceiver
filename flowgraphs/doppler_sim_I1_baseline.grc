    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass rx_pure_doppler_injector(gr.sync_block):\n\
      \    def __init__(self, samp_rate=1000000.0, f_tx=8.4e9, duration=600.0, \n\
      \                 altitude_km=475.0, max_elevation_deg=90.0, inclination_deg=53.0):\n\
      \        \"\"\"\n        Inyector r\xE1pido de Doppler puro basado en Ali et\
      \ al. (1998) Eq. 5.\n        \"\"\"\n        gr.sync_block.__init__(\n     \
      \       self, \n            name='RX Pure Doppler Injector', \n            in_sig=[np.complex64],\
      \ \n            out_sig=[np.complex64]\n        )\n        self.samp_rate =\
      \ samp_rate\n        self.count = 0\n        self.phase_acc = 0.0\n        \n\
      \        # Precalculamos el Doppler a 10 Hz (10 actualizaciones por segundo\
      \ es suficiente)\n        self.lut_rate = 10.0 \n        n_points = int(duration\
      \ * self.lut_rate)\n        t_array = np.linspace(-duration/2, duration/2, n_points)\n\
      \        \n        # Constantes de Astrodin\xE1mica\n        r_E = 6371.0\n\
      \        c_km_s = 299792.458\n        mu = 398600.44\n        r = r_E + altitude_km\n\
      \        \n        # Eq 8 & 9: Velocidad angular aproximada en el marco ECF\n\
      \        omega_s = np.sqrt(mu / (r**3))\n        omega_E = 7.292115e-5\n   \
      \     omega_F = omega_s - omega_E * np.cos(np.radians(inclination_deg))\n  \
      \      \n        # Eq 4: \xC1ngulo central en epoch\n        theta_max = np.radians(max_elevation_deg)\n\
      \        gamma_t0 = np.arccos((r_E/r) * np.cos(theta_max)) - theta_max\n   \
      \     cos_gamma_t0 = np.cos(gamma_t0)\n        \n        # Eq 5: F\xF3rmula\
      \ anal\xEDtica del Doppler\n        psi_diff = omega_F * t_array\n        num\
      \ = r_E * r * np.sin(psi_diff) * cos_gamma_t0 * omega_F\n        den = np.sqrt(r_E**2\
      \ + r**2 - 2 * r_E * r * np.cos(psi_diff) * cos_gamma_t0)\n        \n      \
      \  # Frecuencia real en Hz que \"siente\" el receptor (lleva signo negativo)\n\
      \        self.freq_lut = -(f_tx * (num / den) / c_km_s)\n\n    def work(self,\
      \ input_items, output_items):\n        n = len(input_items[0])\n        \n \
      \       # Buscar la frecuencia en la LUT bas\xE1ndose en el tiempo de simulaci\xF3\
      n\n        t_sec = self.count / self.samp_rate\n        idx = int(t_sec * self.lut_rate)\n\
      \        if idx >= len(self.freq_lut): \n            idx = -1 # Mantiene el\
      \ \xFAltimo valor si nos pasamos del tiempo\n            \n        f_hz = self.freq_lut[idx]\n\
      \        \n        # Multiplicaci\xF3n vectorial masiva en C (S\xFAper r\xE1\
      pido)\n        phase_step = 2.0 * np.pi * f_hz / self.samp_rate\n        phases\
      \ = self.phase_acc + np.arange(1, n + 1) * phase_step\n        \n        output_items[0][:]\
      \ = input_items[0] * np.exp(1j * phases)\n        self.phase_acc = phases[-1]\
      \ % (2 * np.pi)\n        self.count += n\n        \n        return n"
    affinity: ''
    alias: ''
    altitude_km: '512'
    comment: ''
    duration: '175'
    f_tx: f_tx
    inclination_deg: '53.0'
    max_elevation_deg: '90.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: "('RX Pure Doppler Injector', 'rx_pure_doppler_injector', [('samp_rate',\
      \ '1000000.0'), ('f_tx', '8400000000.0'), ('duration', '600.0'), ('altitude_km',\
      \ '475.0'), ('max_elevation_deg', '90.0'), ('inclination_deg', '53.0')], [('0',\
      \ 'complex', 1)], [('0', 'complex', 1)], '\\n        Inyector r\xE1pido de Doppler\
      \ puro basado en Ali et al. (1998) Eq. 5.\\n        ', ['samp_rate'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2496, 384.0]
    rotation: 0
    state: disabled
- name: epy_block_1_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass tx_analytic_precorrector(gr.sync_block):\n\
      \    def __init__(self, samp_rate=1000000.0, f_tx=8.4e9, duration=600.0, \n\
      \                 altitude_km=475.0, max_elevation_deg=90.0, inclination_deg=53.0):\n\
      \        \"\"\"\n        TX Pre-corrector basado en Ali et al. (1998) Eq. 5.\n\
      \        Aplica el Doppler inverso para contrarrestar la f\xEDsica.\n      \
      \  \"\"\"\n        gr.sync_block.__init__(\n            self, \n           \
      \ name='TX Doppler Pre-Corrector', \n            in_sig=[np.complex64], \n \
      \           out_sig=[np.complex64]\n        )\n        self.samp_rate = samp_rate\n\
      \        self.count = 0\n        self.phase_acc = 0.0\n        self.lut_rate\
      \ = 10.0\n        \n        n_points = int(duration * self.lut_rate)\n     \
      \   t_array = np.linspace(-duration/2, duration/2, n_points)\n        \n   \
      \     # Constantes\n        r_E = 6371.0\n        c_km_s = 299792.458\n    \
      \    mu = 398600.44\n        r = r_E + altitude_km\n        \n        omega_s\
      \ = np.sqrt(mu / (r**3))\n        omega_E = 7.292115e-5\n        omega_F = omega_s\
      \ - omega_E * np.cos(np.radians(inclination_deg))\n        \n        theta_max\
      \ = np.radians(max_elevation_deg)\n        gamma_t0 = np.arccos((r_E/r) * np.cos(theta_max))\
      \ - theta_max\n        cos_gamma_t0 = np.cos(gamma_t0)\n        \n        psi_diff\
      \ = omega_F * t_array\n        num = r_E * r * np.sin(psi_diff) * cos_gamma_t0\
      \ * omega_F\n        den = np.sqrt(r_E**2 + r**2 - 2 * r_E * r * np.cos(psi_diff)\
      \ * cos_gamma_t0)\n        \n        # NOTA EL CAMBIO DE SIGNO AQU\xCD: Es positivo\
      \ para pre-cancelar\n        self.freq_lut = (f_tx * (num / den) / c_km_s)\n\
      \n    def work(self, input_items, output_items):\n        n = len(input_items[0])\n\
      \        \n        t_sec = self.count / self.samp_rate\n        idx = int(t_sec\
      \ * self.lut_rate)\n        if idx >= len(self.freq_lut): \n            idx\
      \ = -1\n            \n        f_hz = self.freq_lut[idx]\n        \n        phase_step\
      \ = 2.0 * np.pi * f_hz / self.samp_rate\n        phases = self.phase_acc + np.arange(1,\
      \ n + 1) * phase_step\n        \n        output_items[0][:] = input_items[0]\
      \ * np.exp(1j * phases)\n        self.phase_acc = phases[-1] % (2 * np.pi)\n\
      \        self.count += n\n        \n        return n"
    affinity: ''
    alias: ''
    altitude_km: altitude
    comment: ''
    duration: '175'
    f_tx: f_tx
    inclination_deg: '53.0'
    max_elevation_deg: '90.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: "('TX Doppler Pre-Corrector', 'tx_analytic_precorrector', [('samp_rate',\
      \ '1000000.0'), ('f_tx', '8400000000.0'), ('duration', '600.0'), ('altitude_km',\
      \ '475.0'), ('max_elevation_deg', '90.0'), ('inclination_deg', '53.0')], [('0',\
      \ 'complex', 1)], [('0', 'complex', 1)], '\\n        TX Pre-corrector basado\
      \ en Ali et al. (1998) Eq. 5.\\n        Aplica el Doppler inverso para contrarrestar\
      \ la f\xEDsica.\\n        ', ['samp_rate'])"
