- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass linear_freq_sweep(gr.sync_block):\n\
      \    \"\"\"\n    Bloque que genera un seno con amplitud constante y una frecuencia\n\
      \    que aumenta de forma LINEAL en el tiempo (aceleraci\xF3n constante).\n\
      \    Ideal para ver una rampa recta en la estimaci\xF3n de frecuencia.\n   \
      \ \"\"\"\n    def __init__(self, samp_rate=25000.0, start_freq=0.1, end_freq=100.0,\
      \ sweep_time_s=120.0, amplitude=500.0):\n        gr.sync_block.__init__(\n \
      \           self,\n            name='Linear Freq Sweep',\n            in_sig=None,\n\
      \            out_sig=[np.float32] # Se\xF1al flotante\n        )\n        self.samp_rate\
      \ = samp_rate\n        self.start_freq = start_freq\n        self.end_freq =\
      \ end_freq\n        self.sweep_time_s = sweep_time_s\n        self.amplitude\
      \ = amplitude\n\n        self.current_sample = 0\n\n        # Tasa de cambio\
      \ de frecuencia constante (k) en Hz por segundo.\n        # Esto es lo que te\
      \ dar\xE1 una l\xEDnea recta constante si mides el df/dt.\n        self.k =\
      \ (self.end_freq - self.start_freq) / self.sweep_time_s\n\n    def work(self,\
      \ input_items, output_items):\n        out = output_items[0]\n        n = len(out)\n\
      \n        # Crear vector de tiempo para este bloque de muestras\n        t =\
      \ (self.current_sample + np.arange(n)) / self.samp_rate\n        self.current_sample\
      \ += n\n\n        phase = np.zeros(n)\n        \n        # Separar el tiempo\
      \ en dos partes: durante la rampa y despu\xE9s de la rampa\n        mask_sweep\
      \ = t <= self.sweep_time_s\n        mask_hold = ~mask_sweep\n        \n    \
      \    # 1. Durante el barrido (Frecuencia sube como una rampa lineal)\n     \
      \   if np.any(mask_sweep):\n            # La fase es la integral de una rampa:\
      \ f(t) = start_freq + k*t\n            phase[mask_sweep] = 2.0 * np.pi * (self.start_freq\
      \ * t[mask_sweep] + 0.5 * self.k * (t[mask_sweep]**2))\n        \n        #\
      \ 2. Cuando termina el barrido (Mantiene la frecuencia m\xE1xima plana)\n  \
      \      if np.any(mask_hold):\n            # Fase acumulada justo al final del\
      \ barrido\n            phase_end = 2.0 * np.pi * (self.start_freq * self.sweep_time_s\
      \ + 0.5 * self.k * (self.sweep_time_s**2))\n            # A partir de ah\xED\
      , la fase sube con la end_freq fija\n            phase[mask_hold] = phase_end\
      \ + 2.0 * np.pi * self.end_freq * (t[mask_hold] - self.sweep_time_s)\n\n   \
      \     # Generar el seno con la fase calculada y la amplitud fija\n        out[:]\
      \ = self.amplitude * np.sin(phase)\n\n        return n"
    affinity: ''
    alias: ''
    amplitude: 5e2
    comment: ''
    end_freq: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    start_freq: '0.001'
    sweep_time_s: '60'
  states:
    _io_cache: "('Linear Freq Sweep', 'linear_freq_sweep', [('samp_rate', '25000.0'),\
      \ ('start_freq', '0.1'), ('end_freq', '100.0'), ('sweep_time_s', '120.0'), ('amplitude',\
      \ '500.0')], [], [('0', 'float', 1)], '\\n    Bloque que genera un seno con\
      \ amplitud constante y una frecuencia\\n    que aumenta de forma LINEAL en el\
      \ tiempo (aceleraci\xF3n constante).\\n    Ideal para ver una rampa recta en\
      \ la estimaci\xF3n de frecuencia.\\n    ', ['amplitude', 'end_freq', 'samp_rate',\
      \ 'start_freq', 'sweep_time_s'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1640, 852.0]
    rotation: 0
    state: disabled
